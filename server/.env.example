# ── Dexter Backend Environment ──
# Copy to .env and fill in values

# Server
DEXTER_HOST=0.0.0.0
DEXTER_PORT=8000

# Ollama (install: https://ollama.com)
DEXTER_OLLAMA_BASE_URL=http://localhost:11434
DEXTER_OLLAMA_MODEL=qwen2.5:32b
DEXTER_OLLAMA_EMBED_MODEL=nomic-embed-text
DEXTER_OLLAMA_FAST_MODEL=llama3.2:3b

# PostgreSQL (install + enable pgvector extension)
DEXTER_DATABASE_URL=postgresql://dexter:dexter@localhost:5432/dexter

# Voice (Phase 3)
DEXTER_WHISPER_MODEL=base
DEXTER_PIPER_VOICE_ORCH=en_US-lessac-medium
DEXTER_PIPER_VOICE_SHADOW=en_US-alan-medium

# Tools (Phase 2)
DEXTER_SEARXNG_URL=http://localhost:8888

# Notifications (Phase 4)
DEXTER_NTFY_TOPIC=dexter-gates
DEXTER_NTFY_SERVER=https://ntfy.sh

# DeepSeek — primary intelligence layer (cheapest path to a working brain;
# get a key at https://platform.deepseek.com → API Keys)
DEXTER_DEEPSEEK_API_KEY=
DEXTER_DEEPSEEK_MODEL=deepseek-chat
DEXTER_DEEPSEEK_REASONER_MODEL=deepseek-reasoner
# auto = Ollama if healthy, else DeepSeek if key set, else stub
DEXTER_PRIMARY_PROVIDER=auto

# Cloud APIs (Phase 5 — paid escalation, leave blank until needed)
DEXTER_ANTHROPIC_API_KEY=
DEXTER_OPENAI_API_KEY=
DEXTER_GROQ_API_KEY=

# Budget
DEXTER_DAILY_CLOUD_BUDGET=5.00
DEXTER_PER_TASK_BUDGET_DEFAULT=0.50

# Auth (off by default — the app works with no login until you turn this on; see
# docs/PHASE_3_4_PLAN.md §1)
DEXTER_REQUIRE_AUTH=false
DEXTER_SESSION_TTL_DAYS=30

# Prometheus MCP bridge — project management (docs/PHASE_3_4_PLAN.md §4). Mint a token
# in Prometheus under Settings → Connections, and use its MCP endpoint URL (…/mcp).
DEXTER_PROMETHEUS_MCP_URL=
DEXTER_PROMETHEUS_MCP_TOKEN=
